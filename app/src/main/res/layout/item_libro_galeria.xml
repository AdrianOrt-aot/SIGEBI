<?xml version="1.0" encoding="utf-8"?>
<!-- Tarjeta de la galería horizontal de novedades (MainActivity) -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cardGaleria"
    android:layout_width="120dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="12dp"
    android:background="@drawable/bg_dashboard_card"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground"
    android:orientation="vertical"
    android:padding="8dp">

    <ImageView
        android:id="@+id/imgPortadaGaleria"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:background="@drawable/bg_fondo_categoria"
        android:contentDescription="Portada del libro"
        android:scaleType="centerCrop" />

    <TextView
        android:id="@+id/txtTituloGaleria"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="Título"
        android:textColor="#111111"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtAutorGaleria"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Autor"
        android:textColor="#666666"
        android:textSize="12sp" />

</LinearLayout>