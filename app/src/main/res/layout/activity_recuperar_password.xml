<?xml version="1.0" encoding="utf-8"?>
<!-- Recuperar contraseña: mismo estilo que activity_login.xml -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/fondo_uthh"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#990F4B31" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/fondo_login"
                android:elevation="8dp"
                android:orientation="vertical"
                android:padding="24dp">

                <ImageView
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:layout_gravity="center_horizontal"
                    android:src="@drawable/logo_bibliotek"
                    android:scaleType="fitCenter"
                    android:contentDescription="Logotipo BiblioteK" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:text="Recuperar contraseña"
                    android:textColor="#212121"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="Te enviaremos un enlace y un código al correo registrado en tu cuenta."
                    android:textColor="#666666"
                    android:textSize="14sp" />

                <!-- Tipo de cuenta -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Tipo de cuenta"
                    android:textColor="#212121"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/rgTipoCuenta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rbAlumno"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:buttonTint="@color/verde_boton"
                        android:checked="true"
                        android:text="Alumno" />

                    <RadioButton
                        android:id="@+id/rbTrabajador"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:buttonTint="@color/verde_boton"
                        android:text="Trabajador" />
                </RadioGroup>

                <EditText
                    android:id="@+id/txtIdentificadorRecuperar"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/fondo_campo"
                    android:hint="Matrícula o No. de control"
                    android:inputType="text"
                    android:maxLength="10"
                    android:singleLine="true"
                    android:padding="14dp"
                    android:textColor="#212121"
                    android:textColorHint="#777777" />

                <Button
                    android:id="@+id/btnEnviarEnlace"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginTop="16dp"
                    android:backgroundTint="@color/verde_boton"
                    android:text="Enviar instrucciones"
                    android:textAllCaps="false"
                    android:textColor="@color/blanco"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <!-- Mensajes de éxito o error -->
                <TextView
                    android:id="@+id/txtMensajeRecuperar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <ProgressBar
                    android:id="@+id/progresoRecuperar"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="8dp"
                    android:indeterminateTint="@color/verde_boton"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/txtYaTengoCodigo"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="Ya tengo un código"
                    android:textColor="#134D31"
                    android:textStyle="bold" />

                <!-- Paso 2: código del correo + nueva contraseña -->
                <LinearLayout
                    android:id="@+id/layoutRestablecer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Pega el código que llegó a tu correo y escribe tu nueva contraseña (mínimo 12 caracteres)."
                        android:textColor="#666666"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/txtCodigo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="56dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/fondo_campo"
                        android:hint="Código de recuperación"
                        android:inputType="textNoSuggestions|textMultiLine"
                        android:maxLength="64"
                        android:padding="14dp"
                        android:textColor="#212121"
                        android:textColorHint="#777777"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/txtNuevaContrasena"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/fondo_campo"
                        android:hint="Nueva contraseña"
                        android:inputType="textPassword"
                        android:singleLine="true"
                        android:padding="14dp"
                        android:textColor="#212121"
                        android:textColorHint="#777777" />

                    <EditText
                        android:id="@+id/txtConfirmarContrasena"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/fondo_campo"
                        android:hint="Confirmar contraseña"
                        android:inputType="textPassword"
                        android:singleLine="true"
                        android:padding="14dp"
                        android:textColor="#212121"
                        android:textColorHint="#777777" />

                    <Button
                        android:id="@+id/btnRestablecer"
                        android:layout_width="match_parent"
                        android:layout_height="55dp"
                        android:layout_marginTop="16dp"
                        android:backgroundTint="@color/verde_oscuro"
                        android:text="Cambiar contraseña"
                        android:textAllCaps="false"
                        android:textColor="@color/blanco"
                        android:textSize="17sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txtVolverLogin"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="Volver a iniciar sesión"
                    android:textColor="#666666" />

            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
