<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SIGEBI">

        <!-- Pantalla inicial: Login -->
        <activity
            android:name=".Vista.LoginActivity"
            android:exported="true"
            android:label="@string/title_activity_login"
            android:theme="@style/Theme.SIGEBI"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Recuperar contraseña (desde el Login) -->
        <activity
            android:name=".Vista.RecuperarPasswordActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Pantalla principal despues del Login -->
        <activity
            android:name=".Vista.MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Pantalla del catalogo de libros -->
        <activity
            android:name=".Vista.ActivityCatalogo"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Pantalla del detalle de un libro -->
        <activity
            android:name=".Vista.ActivityDetalleLibro"
            android:exported="false" />
        <activity
            android:name=".Vista.PerfilActivity"
            android:exported="false" />
        <activity
            android:name=".Vista.ActivitySolicitudes"
            android:exported="false"/>
    </application>

</manifest>